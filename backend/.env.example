# Core sketch-to-image backend
HOST=0.0.0.0
PORT=8000
DEBUG_MODE=false
DEVICE=auto
DEFAULT_MODEL_ID=controlnet_scribble
NUM_INFERENCE_STEPS=20
GUIDANCE_SCALE=7.5
OUTPUT_IMAGE_SIZE=512
FRONTEND_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3000
DATASET_DIR=dataset

# Keep the official InstantMesh runtime separate from FastAPI's Diffusers env.
INSTANTMESH_DIR=/content/InstantMesh
INSTANTMESH_PYTHON=/content/instantmesh-venv/bin/python
# Empty uses backend/config/instant-mesh-large-t4.yaml (grid_res=64).
INSTANTMESH_CONFIG=
INSTANTMESH_TIMEOUT=1800
